# ===================================
# Auth0 Configuration (REQUIRED)
# ===================================
# Get these values from your Auth0 Dashboard:
# https://manage.auth0.com/

# Your Auth0 domain (e.g., "your-tenant.us.auth0.com")
AUTH0_DOMAIN=your-tenant.auth0.com

# Your Auth0 API Audience/Identifier (e.g., "https://your-api-identifier")
AUTH0_API_AUDIENCE=https://your-api-identifier

# JWT verification algorithms (usually RS256 for Auth0)
AUTH0_ALGORITHMS=["RS256"]

# Optional: Auth0 issuer URL (defaults to https://{AUTH0_DOMAIN}/)
# AUTH0_ISSUER=https://your-tenant.auth0.com/

# ===================================
# MongoDB Configuration
# ===================================
# MongoDB connection string
# For Docker: mongodb://admin:password@mongodb:27017/?authSource=admin
# For local: mongodb://localhost:27017/
MONGO_URI=mongodb://admin:password@mongodb:27017/?authSource=admin

# Database name
MONGO_DATABASE_NAME=study_planning

# ===================================
# Ollama Configuration
# ===================================
# Ollama service URL
# For Docker: http://ollama:11434
# For local: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Default LLM model
OLLAMA_MODEL=llama2

# Timeout for LLM queries in seconds (default: 180 = 3 minutes)
OLLAMA_TIMEOUT=180

# ===================================
# LLM Response Configuration
# ===================================
# Language detection: "auto", "spanish", "english"
DEFAULT_LANGUAGE=auto

# Custom instructions for LLM responses (optional)
RESPONSE_INSTRUCTIONS=

# Maximum context length sent to LLM (in characters)
# Gemma 3 supports ~400K chars, but 32K is optimal for RTX 3070 8GB
MAX_CONTEXT_LENGTH=32000

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins
# For development: http://localhost:3000,http://localhost:8000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===================================
# Application Configuration
# ===================================
# Upload directory (relative to CODE/)
UPLOAD_DIR=data/uploads

# ChromaDB directory (relative to CODE/)
CHROMADB_PATH=data/chroma_db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
