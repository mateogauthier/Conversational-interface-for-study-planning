# ============================================
# DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE_NAME=study_planning

# ============================================
# AUTH0 CONFIGURATION
# ============================================

# Frontend Auth0 (Public - embedded in JavaScript)
VITE_AUTH0_DOMAIN=your-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your_frontend_client_id
VITE_AUTH0_AUDIENCE=https://study-planning-api
VITE_AUTH0_REDIRECT_URI=https://your-frontend.ngrok-free.dev

# Backend Auth0 (SENSITIVE - keep secret!)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_API_AUDIENCE=https://study-planning-api
AUTH0_CLIENT_ID=your_backend_client_id
AUTH0_CLIENT_SECRET=your_backend_client_secret

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_URL=https://your-api.ngrok-free.dev
CORS_ORIGINS=https://your-frontend.ngrok-free.dev,https://your-api.ngrok-free.dev,http://localhost:3000

# ============================================
# NGROK CONFIGURATION
# ============================================
# Get these from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_FRONTEND_DOMAIN=your-frontend.ngrok-free.dev
NGROK_API_DOMAIN=your-api.ngrok-free.dev

# ============================================
# OLLAMA (LLM) CONFIGURATION
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:latest

# ============================================
# RAG & LLM RESPONSE CONFIGURATION
# ============================================
DEFAULT_LANGUAGE=spanish
RESPONSE_INSTRUCTIONS=
MAX_CONTEXT_LENGTH=1500
UPLOAD_DIR=data/uploads

# ============================================
# AGENT CONFIGURATION
# ============================================
# Agent provider: 'local', 'langgraph', or 'api'
AGENT_PROVIDER=langgraph
