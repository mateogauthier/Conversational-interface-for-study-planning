# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# All environment variables for the Study Planning application

# ============================================
# DATABASE
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE_NAME=study_planning

# ============================================
# AUTH0 AUTHENTICATION
# ============================================

# Frontend Auth0 (Public - embedded in JavaScript bundle)
VITE_AUTH0_DOMAIN=your-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your_frontend_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience
VITE_AUTH0_REDIRECT_URI=http://localhost:3000

# Backend Auth0 (SENSITIVE - server-side only!)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_API_AUDIENCE=https://your-api-audience
AUTH0_CLIENT_ID=your_backend_client_id
AUTH0_CLIENT_SECRET=your_backend_client_secret

# ============================================
# API & CORS
# ============================================
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# LLM SERVICE (OLLAMA)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2:latest

# ============================================
# RAG & RESPONSE SETTINGS
# ============================================
DEFAULT_LANGUAGE=auto
RESPONSE_INSTRUCTIONS=
MAX_CONTEXT_LENGTH=1500
UPLOAD_DIR=data/uploads

# ============================================
# AGENT CONFIGURATION
# ============================================
# Options: 'local', 'langgraph', or 'api'
AGENT_PROVIDER=langgraph
